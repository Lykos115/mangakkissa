    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "5.1.4",
    "jsdom": "27.4.0",
    "supertest": "7.2.2",
